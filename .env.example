# Copy to .env and adjust. No secrets are needed for the demo setup.
PORT=3000
DB_PATH=./data/app.db
UPLOADS_DIR=./uploads
# Login (default): passwords + 48h sessions. The first run creates the
# admin account (username "rivaldo") and prints a one-time password in
# the server log; change it on first login, then create the team
# accounts from the Admin view.
# DEMO_ACTING_AS=true restores the old "Acting as" switcher and skips
# login. Dev/demo only, never for team use.
DEMO_ACTING_AS=false
# COOKIE_SECURE=true only when the dashboard is served over HTTPS.
# Leave off for the plain-http Tailscale setup.
COOKIE_SECURE=false
