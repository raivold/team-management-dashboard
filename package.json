{
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "antd": "^5.29.3",
    "dayjs": "^1.11.23",
    "express": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "description": "Team management dashboard for an ISP NOC team — Kanban, monthly log + shifts, daily material cycle, evidence photos. Self-hostable on one VM.",
  "engines": {
    "node": ">=22"
  },
  "main": "server.js",
  "name": "team-management-dashboard",
  "scripts": {
    "dev": "vite --config client/vite.config.ts",
    "dev:server": "node server.js",
    "build": "vite build --config client/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "start": "node server.js",
    "preview": "vite preview --config client/vite.config.ts"
  },
  "type": "module",
  "version": "2.1.0",
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
